APP_NAME="Sodano Parking Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8001

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT
APP_TIMEZONE=Europe/Rome

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Inserire un percorso assoluto al file isolato della demo.
DB_DATABASE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=sync
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=array
MAIL_FROM_ADDRESS="demo@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Scenario dimostrativo isolato
DEMO_MODE=true
DEMO_BRAND_NAME="Sodano Consulting"
DEMO_BRAND_URL="https://sodanoconsulting.it"
DEMO_DAYS_BEFORE=7
DEMO_DAYS_AFTER=23
DEMO_API_LATENCY_MS=650
DEMO_RESERVATIONS_PER_DAY=3

# I connettori sono visibili nell'interfaccia, ma DEMO_MODE li sostituisce
# con adapter locali e impedisce richieste HTTP non previste.
PARKOS_ENABLED=true
PARKOS_BASE_URL=http://127.0.0.1/disabled
PARKOS_USERNAME=
PARKOS_PASSWORD=
PARKOS_CLIENT_ID=
PARKOS_CLIENT_SECRET=

VOLOGIO_ENABLED=true
VOLOGIO_BASE_URL=http://127.0.0.1/disabled
VOLOGIO_API_KEY=
VOLOGIO_CLIENT_ID=

PARKING_MY_CAR_ENABLED=true
PARKING_MY_CAR_BASE_URL=http://127.0.0.1/disabled
PARKING_MY_CAR_CLIENT_ID=
PARKING_MY_CAR_CLIENT_SECRET=
PARKING_MY_CAR_USERNAME=
PARKING_MY_CAR_PASSWORD=

# I pagamenti reali restano disabilitati e sono bloccati anche nei controller.
PAYMENTS_ENABLED=false
PAYMENT_CURRENCY=EUR
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=EUR
